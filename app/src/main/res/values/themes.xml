<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MUST be an AppCompat theme: MainActivity extends AppCompatActivity,
         and AppCompat throws IllegalStateException at launch otherwise. -->
    <style name="Theme.HadiAI" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
